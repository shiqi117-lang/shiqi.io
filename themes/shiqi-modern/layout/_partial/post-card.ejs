<article class="post-card">
  <div class="post-card-meta">
    <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY.MM.DD') %></time>
    <% if (post.categories && post.categories.length) { %>
      <span aria-hidden="true">·</span>
      <span><%= post.categories.first().name %></span>
    <% } %>
  </div>
  <h2><a href="<%= url_for(post.path) %>"><%= post.title || '未命名文章' %></a></h2>
  <p><%= truncate(strip_html(post.excerpt || post.content), { length: 150 }) %></p>
  <div class="post-card-footer">
    <div class="tag-row">
      <% if (post.tags && post.tags.length) { post.tags.limit(3).each(function(tag) { %>
        <span class="tag"># <%= tag.name %></span>
      <% }); } %>
    </div>
    <a class="read-more" href="<%= url_for(post.path) %>" aria-label="阅读《<%= post.title %>》">阅读全文 <span aria-hidden="true">→</span></a>
  </div>
</article>

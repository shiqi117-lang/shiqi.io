<section class="page-shell archive-page">
  <header class="page-heading">
    <span class="eyebrow">JOURNAL</span>
    <h1><%= title %></h1>
    <p>共 <%= page.posts.length %> 篇内容，按时间持续记录。</p>
  </header>
  <div class="timeline">
    <% let currentYear = null; page.posts.each(function(post) { const year = post.date.year(); %>
      <% if (year !== currentYear) { currentYear = year; %>
        <div class="timeline-year"><%= year %></div>
      <% } %>
      <article class="timeline-item">
        <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MM.DD') %></time>
        <h2><a href="<%= url_for(post.path) %>"><%= post.title || '未命名文章' %></a></h2>
        <span aria-hidden="true">↗</span>
      </article>
    <% }); %>
  </div>
  <%- partial('pagination') %>
</section>

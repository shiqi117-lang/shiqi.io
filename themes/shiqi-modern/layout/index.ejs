<%
  const roadmap = theme.roadmap || {};
  const stages = roadmap.stages || [];
  const statusText = { done: '已完成', active: '进行中', todo: '待开始' };
  const statusClass = { done: 'is-done', active: 'is-active', todo: '' };
%>

<section class="hero page-shell">
  <div class="hero-copy">
    <span class="eyebrow"><%= theme.hero.eyebrow %></span>
    <h1><%= theme.hero.title %></h1>
    <p class="hero-lead"><%= theme.hero.description %></p>
    <div class="hero-actions">
      <a class="button button-primary" href="#roadmap">查看学习路线 <span aria-hidden="true">↓</span></a>
      <a class="button" href="#latest-posts">浏览文章</a>
    </div>
    <% if (theme.hero.chips && theme.hero.chips.length) { %>
      <div class="chip-row">
        <% theme.hero.chips.forEach(function(chip) { %>
          <span class="chip"><%= chip %></span>
        <% }); %>
      </div>
    <% } %>
  </div>

  <aside class="hero-panel" aria-label="当前状态">
    <h2><%= theme.hero.status_title || '当前状态' %></h2>
    <dl class="status-list">
      <% (theme.hero.status || []).forEach(function(row) { %>
        <div class="status-row">
          <dt><%= row.label %></dt>
          <dd><%= row.value %></dd>
        </div>
      <% }); %>
    </dl>
  </aside>
</section>

<% if (stages.length) { %>
<section id="roadmap" class="section page-shell">
  <div class="section-heading">
    <div>
      <span class="eyebrow"><%= roadmap.eyebrow %></span>
      <h2><%= roadmap.title %></h2>
      <p><%= roadmap.description %></p>
    </div>
    <a href="<%= url_for('/roadmap/') %>">查看完整路线 <span aria-hidden="true">→</span></a>
  </div>

  <div class="stage-grid">
    <% stages.forEach(function(stage) { %>
      <article class="stage-card">
        <span class="status-tag <%= statusClass[stage.status] || '' %>"><%= statusText[stage.status] || '待开始' %></span>
        <span class="stage-index"><%= stage.id %></span>
        <h3><%= stage.title %></h3>
        <p class="stage-goal"><%= stage.goal %></p>
        <p class="stage-output"><strong>关键产出</strong><%= stage.output %></p>
      </article>
    <% }); %>
  </div>

  <% if (roadmap.principles && roadmap.principles.length) { %>
    <div class="principle-row">
      <% roadmap.principles.forEach(function(item) { %>
        <div class="principle">
          <strong><%= item.title %></strong>
          <span><%= item.text %></span>
        </div>
      <% }); %>
    </div>
  <% } %>
</section>
<% } %>

<section id="latest-posts" class="section page-shell">
  <div class="section-heading">
    <div>
      <span class="eyebrow">LATEST WRITING</span>
      <h2>最近更新</h2>
    </div>
    <a href="<%= url_for('/archives/') %>">查看全部 <span aria-hidden="true">→</span></a>
  </div>
  <div class="post-grid">
    <% page.posts.each(function(post) { %>
      <%- partial('_partial/post-card', { post: post }) %>
    <% }); %>
  </div>
  <%- partial('_partial/pagination') %>
</section>
